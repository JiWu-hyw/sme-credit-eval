{
  "name": "credit-eval-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "融合技术要素与成长轨迹的中小科技企业信用智能评估方法构建 · 原型系统前端（FE-00 工程骨架）",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build-only": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test:routes": "node scripts/route-smoke.mjs",
    "test:api": "node scripts/api-smoke.mjs",
    "test:p1": "node scripts/p1-smoke.mjs",
    "test:redline": "node scripts/redline-smoke.mjs",
    "test:layout": "node scripts/layout-smoke.mjs",
    "test:p2": "node scripts/p2-smoke.mjs",
    "test:p3": "node scripts/p3-smoke.mjs",
    "test:p4p5": "node scripts/p4p5-smoke.mjs",
    "test:p5": "node scripts/p5-smoke.mjs",
    "test:p6": "node scripts/p6-smoke.mjs",
    "test:dist": "node scripts/dist-check.mjs",
    "shots:p1": "node scripts/p1-shots.mjs",
    "shots:p2": "node scripts/p2-shots.mjs",
    "shots:p3": "node scripts/p3-shots.mjs",
    "shots:p4p5": "node scripts/p4p5-shots.mjs",
    "shots:p5": "node scripts/p5-shots.mjs",
    "shots:p6": "node scripts/p6-shots.mjs",
    "contracts:build": "python3 scripts/build_data_contracts.py",
    "contracts:graph": "python3 scripts/build_graph_contracts.py",
    "contracts:model": "python3 scripts/build_model_contracts.py",
    "contracts:explain": "python3 scripts/build_explain_contracts.py",
    "contracts:forecast": "python3 scripts/build_forecast_contracts.py",
    "test": "npm run test:routes && npm run test:api && npm run test:p1 && npm run test:redline && npm run test:layout && npm run test:p2 && npm run test:p4p5 && npm run test:p5 && npm run test:p3 && npm run test:p6 && npm run test:p7 && npm run test:p8 && npm run test:dist",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" \"*.{ts,js,json,md}\"",
    "test:p7": "node scripts/p7-smoke.mjs",
    "shots:p7": "node scripts/p7-shots.mjs",
    "contracts:enterprise": "python3 scripts/build_enterprise_contracts.py --all",
    "test:p8": "node scripts/p8-smoke.mjs",
    "shots:p8": "node scripts/p8-shots.mjs",
    "contracts:batch": "python3 scripts/build_batch_contracts.py --all",
    "preview:dist": "node server.mjs"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "echarts": "^5.6.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.4.0",
    "eslint": "^9.19.0",
    "eslint-plugin-vue": "^9.32.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.64.1",
    "prettier": "^3.4.2",
    "typescript": "~5.7.3",
    "vite": "^6.0.11",
    "vue-tsc": "^2.2.0"
  }
}
