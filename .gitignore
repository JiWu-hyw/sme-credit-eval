# ---- 项目数据 ----
# 原始数据体积大且含敏感信息，不纳入版本库（按需向资产库获取）
data/raw/*
!data/raw/.gitkeep

# 数据库产物
data/db/*.db
data/db/*.db-journal
data/db/*.sqlite
data/db/*.sqlite3

# 中间产物与模型权重
data/processed/*.parquet
data/processed/*.tmp
*.h5
*.hdf5
*.pth
*.pt
*.ckpt
*.onnx
*.pkl
*.joblib

# 输出产物（可由脚本重跑生成）
outputs/*.png
outputs/*.pdf
outputs/_tmp/

# 环境变量与密钥
.env
.env.*
!.env.example
*.pem
*.key
secrets.yaml
secrets.yml

# 构建与预览产物
