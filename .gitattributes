# 大数据文件走 Git LFS（若要入库时启用；当前 .gitignore 已将 *.db 排除）
# 启用方式：git lfs install && git lfs track "data/db/*.db" && git add data/db/zjtech_credit.db
*.db       filter=lfs diff=lfs merge=lfs -text
*.sqlite   filter=lfs diff=lfs merge=lfs -text
*.sqlite3  filter=lfs diff=lfs merge=lfs -text

# 换行统一：跨平台协作，文本文件在仓库内一律存 LF
* text=auto eol=lf
*.png binary
*.jpg binary
*.xlsx binary
